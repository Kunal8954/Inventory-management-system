# Copy this file to .env and fill in real values.
# Never commit the actual .env file — it's already in .gitignore.

# --- Database ---
DB_HOST=localhost
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=ims
DB_PORT=3306

# --- Auth ---
# Any long random string — used to sign Bearer tokens. Generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Email (Resend API, used for OTP verification) ---
# Get a key from https://resend.com/api-keys
RESEND_API_KEY=
